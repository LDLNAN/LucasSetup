// Generated by gen-outputs.sh - re-run it when your monitors change.
// Everything else in config.kdl is machine-independent.

// PNP(AOC) 2490W1  serial APGL69A001063
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=1920 y=-1080
}

// Dell Inc. AW2521HFL  serial 8TK3M23
output "DP-2" {
    mode "1920x1080@239.757"
    scale 1
    transform "normal"
    position x=1920 y=0
}

