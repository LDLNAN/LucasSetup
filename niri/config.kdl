// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// https://niri-wm.github.io/niri/Configuration:-Introduction
//
// Binds mirror Lucas's COSMIC shortcuts: WASD focus/move, z/x workspaces,
// Alt+hjkl/arrows for outputs.
//
// Note on "Mod": it equals Super on a real session, Alt when niri runs nested
// in a window. Everything below uses Mod, so it's Super in practice.

// ---------------------------------------------------------------------------
// Startup
// ---------------------------------------------------------------------------

// Noctalia. Uses spawn-sh-at-startup with a short delay: plain
// spawn-at-startup can fire before the Wayland socket is ready, and it does
// not go through a shell (no PATH expansion, no ~).
spawn-sh-at-startup "sleep 1 && /usr/bin/noctalia"


environment
// If the delay turns out to be unnecessary, this simpler form also works:
//   spawn-at-startup "/usr/bin/noctalia"
//
// Note: spawn-at-startup only fires when niri STARTS. Editing this line and
// saving does not relaunch it — you have to log out and back in.

// (waybar removed — Noctalia provides the bar.)

// ---------------------------------------------------------------------------
// Input
// ---------------------------------------------------------------------------

input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
            // For more information, see xkeyboard-config(7).
            //
            // NOTE: if you set a layout-switch option here (e.g. grp:win_space_toggle),
            // remove the Mod+Space switch-layout bind below, or it'll toggle twice.
        }

        // Enable numlock on startup.
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"

        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
    }

    // warp-mouse-to-focus
    // focus-follows-mouse max-scroll-amount="0%"
}

// ---------------------------------------------------------------------------
// Outputs — run `niri msg outputs` inside niri to get names/modes.
// ---------------------------------------------------------------------------

/-output "eDP-1" {
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=1280 y=0
}

// ---------------------------------------------------------------------------
// Layout
// ---------------------------------------------------------------------------

layout {
    gaps 8

    center-focused-column "never"

    // Widths cycled by Mod+Shift+E (switch-preset-column-width).
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off

        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        width 2
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        on

        // on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------

hotkey-overlay {
    // skip-at-startup
}

// prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 0.7000000000000001

    // off
    // slowdown 3.0
}

debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
    force-tearing
}

// ---------------------------------------------------------------------------
// Window rules
// ---------------------------------------------------------------------------

// Rounded corners for everything (Noctalia's recommended look).
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

// Floating Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Float the btop system-monitor window (Ctrl+Shift+Escape).
window-rule {
    match title="^btop$"
    open-floating true
    default-column-width { fixed 1400; }
    default-window-height { fixed 900; }
}

// Work around WezTerm's initial configure bug.
window-rule {
    match app-id=r"^org\.wezfurlong\.wezterm$"
    default-column-width {
    }
}

// Firefox picture-in-picture floats.
window-rule {
    match app-id=r"firefox$" title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out password managers from screen capture.
/-window-rule {
    match app-id=r"^org\.keepassxc\.KeePassXC$"
    match app-id=r"^org\.gnome\.World\.Secrets$"
    block-out-from "screen-capture"
}

// ---------------------------------------------------------------------------
// Binds — ONE block only. niri does not merge multiple binds{} sections.
// ---------------------------------------------------------------------------

binds {

    // === Navigation: focus (COSMIC Super+WASD) ==========================
    // left/right move between columns, up/down within a column.

    Mod+A { focus-column-left; }
    Mod+D { focus-column-right; }

    // Monitors are stacked vertically, so W/S moves focus between them.
    Mod+W { focus-monitor-up; }
    Mod+S { focus-monitor-down; }

    // Arrows: up/down move WITHIN a column (W/S are monitors now).
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Home-row alternates for in-column navigation, if you tab/stack columns.
    Mod+Ctrl+W { focus-window-up; }
    Mod+Ctrl+S { focus-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // "Focus window in/out" are Disabled in your COSMIC config — niri's flat
    // layout has no tree to walk anyway, so nothing lost.


    // === Move windows (COSMIC Super+Shift+WASD) =========================

    Mod+Shift+A { move-column-left; }
    Mod+Shift+D { move-column-right; }

    // Monitors are stacked vertically, so W/S sends windows between them.
    Mod+Shift+W { move-column-to-monitor-up; }
    Mod+Shift+S { move-column-to-monitor-down; }

    // Arrows: up/down move a window WITHIN its column.
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }


    // === Workspaces (COSMIC Super+z/x, Super+0) =========================
    // niri stacks workspaces vertically: prev = up, next = down.

    Mod+Z { focus-workspace-up; }
    Mod+X { focus-workspace-down; }
    Mod+0 { focus-workspace-previous; }

    Mod+Shift+Z { move-column-to-workspace-up; }
    Mod+Shift+X { move-column-to-workspace-down; }

    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // "Move window to last workspace" has no niri action.

    // Scroll wheel through workspaces.
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }


    // === Outputs / monitors (COSMIC Super+Alt+hjkl and arrows) ==========

    Mod+Alt+H     { focus-monitor-left; }
    Mod+Alt+Left  { focus-monitor-left; }
    Mod+Alt+L     { focus-monitor-right; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Alt+K     { focus-monitor-up; }
    Mod+Alt+Up    { focus-monitor-up; }
    Mod+Alt+J     { focus-monitor-down; }
    Mod+Alt+Down  { focus-monitor-down; }

    Mod+Alt+Shift+H     { move-column-to-monitor-left; }
    Mod+Alt+Shift+Left  { move-column-to-monitor-left; }
    Mod+Alt+Shift+L     { move-column-to-monitor-right; }
    Mod+Alt+Shift+Right { move-column-to-monitor-right; }
    Mod+Alt+Shift+K     { move-column-to-monitor-up; }
    Mod+Alt+Shift+Up    { move-column-to-monitor-up; }
    Mod+Alt+Shift+J     { move-column-to-monitor-down; }
    Mod+Alt+Shift+Down  { move-column-to-monitor-down; }


    // === Manage windows =================================================

    Mod+Q repeat=false { close-window; }

    Mod+E      { maximize-column; }
           // COSMIC: Maximize window
    Mod+Ctrl+E { maximize-window-to-edges; }
  // closer to a "real" maximize
    Mod+F11    { fullscreen-window; }

    // COSMIC Super+R = Minimize. niri has NO minimize — nowhere for a window
    // to go. Uncomment one of these if you want the key doing something:
    //   Mod+R { move-column-to-workspace 9; }   // manual stash
    //   Mod+R { center-column; }

    // COSMIC: Resize window inwards. (Outwards is Disabled in your config.)
    Mod+Shift+R { set-column-width "-10%"; }
    Mod+Ctrl+R  { set-column-width "+10%"; }
   // the outwards half, if wanted

    // COSMIC Super+Shift+E = Toggle sticky. niri has no sticky windows.
    // Repurposed to the preset-width cycle, the single most-used niri action.
    Mod+Shift+E { switch-preset-column-width; }
    Mod+Ctrl+Shift+E { switch-preset-column-width-back; }

    // Finer sizing.
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }

    Mod+C        { center-column; }
    Mod+Ctrl+C   { center-visible-columns; }
    Mod+Ctrl+F   { expand-column-to-available-width; }


    // === Window tiling ==================================================

    Mod+G { toggle-window-floating; }
                    // exact COSMIC match
    Mod+Y { switch-focus-between-floating-and-tiling; }
  // approx "toggle tiling"

    // COSMIC "toggle orientation" — nearest niri idea is pulling a window into
    // the current column or pushing it back out.
    Mod+O       { consume-or-expel-window-right; }
    Mod+Shift+O { consume-or-expel-window-left; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period  { expel-window-from-column; }

    // Tabbed columns. You have COSMIC stacking Disabled, so this is a bonus.
    Mod+Ctrl+T { toggle-column-tabbed-display; }

    // Swap window / set h+v orientation are Disabled in your COSMIC config.


    // === System / shell =================================================

    // Launcher. COSMIC used a bare Super tap; niri can't bind a lone
    // modifier, so this is on Alt+Space instead.
    Alt+Space hotkey-overlay-title="Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }

    // COSMIC "Open the app library" — Noctalia has no separate library.
    Mod+Caps_Lock { spawn-sh "noctalia msg panel-toggle launcher"; }

    // COSMIC has the overview on XF86LaunchA. That key doesn't exist on most
    // keyboards, so Mod+Grave is here as a usable alternate.
    XF86LaunchA repeat=false { toggle-overview; }
    Mod+Grave repeat=false { toggle-overview; }

    Mod+Tab { spawn-sh "noctalia msg window-switcher"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher"; }
    // Shift+Tab cycles backwards inside Noctalia's switcher once open.

    Mod+Shift+Escape { spawn-sh "noctalia msg panel-toggle session"; }
   // Log Out
    Mod+L allow-inhibiting=false { spawn-sh "noctalia msg session lock"; }

    // COSMIC: Switch keyboard language input source.
    Mod+Space { switch-layout "next"; }

    // Other Noctalia surfaces (no COSMIC counterpart).
    Mod+Comma  { spawn-sh "noctalia msg settings-toggle"; }
    Mod+N      { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Ctrl+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Ctrl+N { spawn-sh "noctalia msg notification-dnd-toggle"; }

    // Escape hatch for apps that grab all shortcuts (VMs, remote desktop).
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Exit niri (shows a confirmation dialog).
    Mod+Ctrl+Alt+Escape { quit; }
    Ctrl+Alt+Delete     { quit; }

    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+Slash { show-hotkey-overlay; }


    // === Applications ===================================================

    Mod+T hotkey-overlay-title="Terminal"     { spawn "ghostty"; }
    Mod+B hotkey-overlay-title="Brave"        { spawn "brave"; }
    Mod+F hotkey-overlay-title="File Manager" { spawn "cosmic-files"; }

    // Task manager, Windows-style. btop in a floating terminal.
    // The --title flag is what the float window-rule matches on.
    Ctrl+Shift+Escape hotkey-overlay-title="System Monitor" { spawn-sh "ghostty --title=btop -e btop"; }


    // === Screenshots ====================================================

    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }
    // Noctalia's own capture instead, if you prefer its save/clipboard policy:
    //   Print { spawn-sh "noctalia msg screenshot-region"; }


    // === Media / hardware keys — via Noctalia so its OSD shows ==========

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "noctalia msg media stop"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
}

// Environment variables for spawned processes go here, e.g.:
//   environment {
//       DISPLAY ":0"
//   }

output "HDMI-A-1" {
    mode "1920x1080@60.000"

    scale 1.0

    transform "normal"
    position x=1920 y=-1080
}
output "DP-2" {
    mode "1920x1080@239.757"

    scale 1.0

    transform "normal"
    position x=1920 y=0

}
prefer-no-csd

gestures {
    hot-corners {
        off

        top-left
    }
}

include "noctalia.kdl"
